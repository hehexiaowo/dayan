    <packaging>pom</packaging>
    <name>dayan-common-bom</name>
    <description>大雁养老 - 公共模块版本统一 BOM</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>dayan-common-core</artifactId>
