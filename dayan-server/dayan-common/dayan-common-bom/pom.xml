            </dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>dayan-common-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>dayan-common-mq</artifactId>
                <version>${project.version}</version>
