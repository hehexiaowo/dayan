            </dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>dayan-common-mybatis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dayan</groupId>
                <artifactId>dayan-common-security</artifactId>
